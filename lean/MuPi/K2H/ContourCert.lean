/-- the polynomial inequality on the whole segment `seg1` -/
theorem seg1_poly (t x y : ℝ) (h0 : 0 ≤ t) (h1 : t ≤ 1) (hx : x = ((1 : ℝ) + ((3403 : ℝ) / 16384) * t)) (hy : y = ((0 : ℝ) + ((32371 : ℝ) / 65536) * t)) :
    numR x y ≤ rhoSq * denR x y := by
  subst hx hy
  have hc := cert_seg1_0 ((t - (0 : ℝ)) / (1 : ℝ)) (1 - (t - (0 : ℝ)) / (1 : ℝ)) rfl
    (div_nonneg (by linarith [h0]) (by norm_num))
    (by rw [sub_nonneg, div_le_one (by norm_num)]; linarith)
  rw [show (0 : ℝ) + (1 : ℝ) * ((t - (0 : ℝ)) / (1 : ℝ)) = t by ring] at hc
  exact hc

/-- the polynomial inequality on the whole segment `seg2` -/
theorem seg2_poly (t x y : ℝ) (h0 : 0 ≤ t) (h1 : t ≤ 1) (hx : x = (((19787 : ℝ) / 16384) + ((-3403 : ℝ) / 16384) * t)) (hy : y = (((32371 : ℝ) / 65536) + ((33165 : ℝ) / 65536) * t)) :
    numR x y ≤ rhoSq * denR x y := by
  subst hx hy
  by_cases hup : t ≤ ((1 : ℝ) / 2)
  · have hc := cert_seg2_0 ((t - (0 : ℝ)) / ((1 : ℝ) / 2)) (1 - (t - (0 : ℝ)) / ((1 : ℝ) / 2)) rfl
      (div_nonneg (by linarith [h0]) (by norm_num))
      (by rw [sub_nonneg, div_le_one (by norm_num)]; linarith)
    rw [show (0 : ℝ) + ((1 : ℝ) / 2) * ((t - (0 : ℝ)) / ((1 : ℝ) / 2)) = t by ring] at hc
    exact hc
  have hlo : ((1 : ℝ) / 2) < t := not_le.1 hup
  have hc := cert_seg2_1 ((t - ((1 : ℝ) / 2)) / ((1 : ℝ) / 2)) (1 - (t - ((1 : ℝ) / 2)) / ((1 : ℝ) / 2)) rfl
    (div_nonneg (by linarith [hlo.le]) (by norm_num))
    (by rw [sub_nonneg, div_le_one (by norm_num)]; linarith)
  rw [show ((1 : ℝ) / 2) + ((1 : ℝ) / 2) * ((t - ((1 : ℝ) / 2)) / ((1 : ℝ) / 2)) = t by ring] at hc
  exact hc

